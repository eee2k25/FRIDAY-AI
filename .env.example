# FRIDAY AI — copy to .env and edit. Nothing here is mandatory.
#
#   cp .env.example .env
#
# Cloud API keys are all optional. A fresh clone with no keys at all still
# works if an Ollama server is reachable — see "Local model server" below, or
# run `./setup.sh --with-ollama` (in a Codespace:
# `bash deploy/codespaces/ollama-server.sh install`, which also writes the four
# Ollama settings in this file for you).
#
# Every setting below is read by config.py; uncomment and change only what you
# need. Repeating a key is not merged — one wins, so keep exactly one per key.

# --- Model selection --------------------------------------------------------
# Provider-neutral names, and they override the legacy GEMINI_* names below.
# A model may carry a provider prefix; no prefix means Google Gemini:
#   ollama/  local or LAN Ollama      e.g. ollama/llama3.2
#   groq/    Groq                     e.g. groq/llama-3.3-70b-versatile
#   openrouter/  OpenRouter           e.g. openrouter/meta-llama/llama-3.3-70b-instruct
#   together/    Together AI          e.g. together/meta-llama/Llama-3.3-70B-Instruct-Turbo
#   deepseek/    DeepSeek             e.g. deepseek/deepseek-chat
#   openai/      any OpenAI-compatible host, see OPENAI_BASE_URL
# A keyless cloud model is skipped; Ollama needs no key and is gated by
# OLLAMA_ENABLED instead.
# FRIDAY_MODEL=gemini-2.5-flash
#
# Tried in order when the model above fails. An *explicitly empty* value turns
# the chain off, which is a decision, not an omission — leaving it unset falls
# through to GEMINI_FALLBACK_MODELS and then to the built-in defaults
# (gemini-2.5-flash-lite, groq/..., ollama).
# FRIDAY_FALLBACK_MODELS=
#
# Alternative local model: first run `ollama pull deepseek-r1:7b`, then set both
# OLLAMA_MODEL and FRIDAY_MODEL to deepseek-r1:7b / ollama/deepseek-r1:7b.

# --- Local model server (Ollama) --------------------------------------------
# The default below is a server on this machine or in this Codespace.
#
# Do NOT put a `*.app.github.dev` forwarded-port URL here when FRIDAY runs in the
# same Codespace as Ollama: that URL round-trips GitHub's proxy and only answers
# once the port's visibility is org/public, so every call comes back as a sign-in
# redirect. Use 127.0.0.1, and reserve the forwarded URL for other machines.
# `python friday.py --doctor` prints this Codespace's forwarded URL if you need it.
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
#
# Set these two to keep every request on the local model, with no cloud provider
# in the chain at all (this is what a Codespace + Ollama setup should look like):
# FRIDAY_MODEL=ollama/llama3.2
# FRIDAY_FALLBACK_MODELS=
# GEMINI_FALLBACK_MODELS=

# --- Cloud provider keys (all optional) -------------------------------------
# Only the provider you actually reference in the model chain needs a key.
# Prefer Codespaces secrets (Repo → Settings → Secrets and variables →
# Codespaces) over putting a key in this file.
# GEMINI_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
# OPENROUTER_API_KEY=your_key_here
# TOGETHER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# DEEPSEEK_API_KEY=your_key_here
# HUGGINGFACE_TOKEN=your_token_here
# Any OpenAI-compatible endpoint can serve the openai/ prefix.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Legacy names -----------------------------------------------------------
# Still honoured, used only when the matching FRIDAY_* variable is absent.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,groq/llama-3.3-70b-versatile,ollama

# --- Persona and agent limits -----------------------------------------------
FRIDAY_USER_NAME=Boss
# MAX_AGENT_ITERATIONS=15
# MAX_CONTEXT_TOKENS=900000      ← enforced: the oldest turns are shed
# MAX_TOOL_RESULT_CHARS=6000
# HISTORY_WINDOW=20
# STREAMING=True

# --- Tool filtering ---------------------------------------------------------
# Only tools relevant to the current request are declared to the model. The full
# set costs ~8.6k tokens on EVERY call — more than the free tiers of the fallback
# providers allow per minute (Groq on-demand: 8k TPM), which used to 413-kill
# every fallback model.
# TOOL_FILTER=True
# MAX_TOOLS_PER_CALL=40          ← 0 always sends every tool

# --- Logging and debug ------------------------------------------------------
DEBUG_MODE=False
LOG_LEVEL=INFO
# LOG_CONSOLE=True               ← mirror log lines to the terminal
# (default: log file only, clean console)

# --- Safety -----------------------------------------------------------------
# What FRIDAY does when a shell command looks catastrophic (rm -rf /, mkfs,
# shutdown, curl | sh, force-push, ...):
#   confirm — ask you on the terminal first (default)
#   block   — refuse and make her suggest something safer
#   allow   — no guard at all
FRIDAY_SHELL_POLICY=confirm

# --- Optional integrations --------------------------------------------------
# ElevenLabs voice channel.
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id
# ELEVENLABS_MODEL=eleven_multilingual_v2
#
# Google Workspace (Gmail, Drive, Calendar, Docs):
#   1. create a Google Cloud OAuth Client ID of type "Desktop app"
#   2. enable the Gmail, Drive, Calendar and Docs APIs
#   3. download the OAuth JSON and point this setting at it
# then ask FRIDAY to "connect Google Workspace" once.
# GOOGLE_CLIENT_SECRET_FILE=C:\path\to\client_secret.json
#
# GitHub: a fine-grained token limited to the repos FRIDAY should access, or
# install gh and run `gh auth login`.
# GITHUB_TOKEN=github_pat_...
#
# Outbound email (Google users can use the OAuth extension instead).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@example.com
#
# Messaging channels.
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# iMessage relay (outbound send + /imessage/webhook inbound).
# IMESSAGE_WEBHOOK_URL=https://your-imessage-relay.example/send
# IMESSAGE_RECIPIENT=+15555550123

# --- Daemon (python friday.py --serve) --------------------------------------
# Set a token to require `Authorization: Bearer <token>` on /, /status and
# /chat. /health stays open for local watchdogs. Keep the daemon on 127.0.0.1
# unless a firewall or reverse proxy sits in front of it.
# FRIDAY_DAEMON_TOKEN=change-me
# FRIDAY_PID_FILE=friday.pid

# --- Release ----------------------------------------------------------------
# Version pin for this checkout; version.py is the source of truth.
FRIDAY_VERSION=1.8.0
