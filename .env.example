# FRIDAY AI Configuration — copy to .env and fill in real keys
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
TOGETHER_API_KEY=your_key_here
HUGGINGFACE_TOKEN=your_token_here
FRIDAY_USER_NAME=Boss
FRIDAY_VERSION=1.0.4
DEBUG_MODE=False
LOG_LEVEL=INFO
# LOG_CONSOLE=True   ← mirror log lines to the terminal (default: logs file only, clean console)

# Optional overrides (defaults in config.py keep your spec intact, but Google
# has delisted the 2.0-flash-exp / 1.5-flash names — set current ones here):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,groq/llama-3.3-70b-versatile
# MAX_AGENT_ITERATIONS=15
# STREAMING=True
