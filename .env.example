# FRIDAY AI Configuration — external provider keys are optional.
# The local-only Ollama example below needs no external API key.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint for the OpenAI provider
# OPENAI_BASE_URL=https://api.openai.com/v1
# HUGGINGFACE_TOKEN=
FRIDAY_USER_NAME=Boss
FRIDAY_VERSION=1.7.0
# Optional daemon settings
# FRIDAY_DAEMON_TOKEN=change-me
# FRIDAY_PID_FILE=friday.pid
# Optional ElevenLabs voice channel
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional Google Workspace extension (Gmail, Drive, Calendar and Docs)
# 1. Create a Google Cloud OAuth Client ID with application type "Desktop app"
# 2. Enable the Gmail, Drive, Calendar and Docs APIs
# 3. Download the OAuth JSON and point this setting at it
# GOOGLE_CLIENT_SECRET_FILE=C:\path\to\client_secret.json
# Then ask FRIDAY to "connect Google Workspace" once.

# Optional GitHub extension. Prefer a fine-grained token limited to the repos
# FRIDAY should access. Alternatively install gh and run: gh auth login
# GITHUB_TOKEN=github_pat_...

# Optional SMTP email channel (Google users can use the OAuth extension instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@example.com
# Optional messaging channels
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DEBUG_MODE=False
LOG_LEVEL=INFO
# LOG_CONSOLE=True   ← mirror log lines to the terminal (default: logs file only, clean console)

# --- Safety -------------------------------------------------------------
# What FRIDAY does when a shell command looks catastrophic (rm -rf /, mkfs,
# shutdown, curl | sh, force-push, ...):
#   confirm — ask you on the terminal first (default)
#   block   — refuse and make her suggest something safer
#   allow   — no guard at all
FRIDAY_SHELL_POLICY=confirm

# --- Local-only Ollama model configuration -------------------------------
# FRIDAY_MODEL takes precedence over GEMINI_MODEL; FRIDAY_FALLBACK_MODELS
# takes precedence over GEMINI_FALLBACK_MODELS. Empty fallbacks mean no cloud
# providers are activated by the model chain.
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
FRIDAY_MODEL=ollama/llama3.2
FRIDAY_FALLBACK_MODELS=
GEMINI_FALLBACK_MODELS=
# Legacy-compatible names (used only if the corresponding FRIDAY_* variable
# is absent); leave blank/commented for a local-only setup.
# GEMINI_MODEL=
# Alternative local model example (first run: `ollama pull deepseek-r1:7b`):
# OLLAMA_MODEL=deepseek-r1:7b
# FRIDAY_MODEL=ollama/deepseek-r1:7b
# Optional cloud-provider fallbacks, only if you explicitly want them:
# GEMINI_MODEL=gemini-2.5-flash
# FRIDAY_FALLBACK_MODELS=groq/llama-3.3-70b-versatile
# MAX_AGENT_ITERATIONS=15
# MAX_CONTEXT_TOKENS=900000    ← now actually enforced: oldest turns are shed
# STREAMING=True

# --- Tool filtering -------------------------------------------------------
# Only tools relevant to the current request are sent to the model. The full
# 108-tool declaration set costs ~8.6k tokens on EVERY call — more than
# free-tier fallback providers allow per minute (Groq on-demand: 8k TPM),
# which used to 413-kill every fallback model.
# TOOL_FILTER=True
# MAX_TOOLS_PER_CALL=40     ← set to 0 to always send every tool
