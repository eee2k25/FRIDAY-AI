# FRIDAY AI Configuration — copy to .env and enable only the providers you use
# Cloud provider keys are optional when using local Ollama.
# GEMINI_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
# OPENROUTER_API_KEY=your_key_here
# TOGETHER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# DEEPSEEK_API_KEY=your_key_here
# Optional OpenAI-compatible endpoint for the OpenAI provider
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama (no external API key required)
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=https://turbo-space-palm-tree-7v6jr5qx5gq4fwxrg-11434.app.github.dev/v1
OLLAMA_MODEL=llama3.2
# HUGGINGFACE_TOKEN=your_token_here
FRIDAY_USER_NAME=Boss
FRIDAY_VERSION=1.8.0
# Optional daemon settings
# FRIDAY_DAEMON_TOKEN=change-me
# FRIDAY_PID_FILE=friday.pid
# Optional ElevenLabs voice channel
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=your_voice_id
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional Google Workspace extension (Gmail, Drive, Calendar and Docs)
# 1. Create a Google Cloud OAuth Client ID with application type "Desktop app"
# 2. Enable the Gmail, Drive, Calendar and Docs APIs
# 3. Download the OAuth JSON and point this setting at it
# GOOGLE_CLIENT_SECRET_FILE=C:\path\to\client_secret.json
# Then ask FRIDAY to "connect Google Workspace" once.

# Optional GitHub extension. Prefer a fine-grained token limited to the repos
# FRIDAY should access. Alternatively install gh and run: gh auth login
# GITHUB_TOKEN=github_pat_...

# Optional SMTP email channel (Google users can use the OAuth extension instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@example.com
# Optional messaging channels
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional iMessage relay (outbound send + /imessage/webhook inbound)
# IMESSAGE_WEBHOOK_URL=https://your-imessage-relay.example/send
# IMESSAGE_RECIPIENT=+15555550123
# IMESSAGE_WEBHOOK_URL=https://your-imessage-relay.example/send
# IMESSAGE_RECIPIENT=+15555550123
DEBUG_MODE=False
LOG_LEVEL=INFO
# LOG_CONSOLE=True   ← mirror log lines to the terminal (default: logs file only, clean console)

# --- Safety -------------------------------------------------------------
# What FRIDAY does when a shell command looks catastrophic (rm -rf /, mkfs,
# shutdown, curl | sh, force-push, ...):
#   confirm — ask you on the terminal first (default)
#   block   — refuse and make her suggest something safer
#   allow   — no guard at all
FRIDAY_SHELL_POLICY=confirm

# --- Optional model overrides -------------------------------------------
# FRIDAY_MODEL / FRIDAY_FALLBACK_MODELS are provider-neutral and take
# precedence over the legacy GEMINI_MODEL / GEMINI_FALLBACK_MODELS names,
# which are still honoured so existing .env files keep working.
#
# Any model may carry a provider prefix: ollama/, groq/, openrouter/,
# together/, deepseek/, openai/. No prefix means Google Gemini. Cloud models
# without their API key are skipped; Ollama is local and keyless, and
# `ollama` alone expands to OLLAMA_MODEL. Tagged models work as-is
# (ollama/deepseek-r1:7b, ollama/qwen2.5:7b).
# OLLAMA_ENABLED=True
# OLLAMA_BASE_URL=https://turbo-space-palm-tree-7v6jr5qx5gq4fwxrg-11434.app.github.dev/v1
# OLLAMA_MODEL=llama3.2
# FRIDAY_MODEL=gemini-2.5-flash
# FRIDAY_FALLBACK_MODELS=gemini-2.5-flash-lite,groq/llama-3.3-70b-versatile,openrouter/meta-llama/llama-3.3-70b-instruct,ollama
#
# To run ONLY the local Ollama model, set these two. Note that an *explicitly
# empty* FRIDAY_FALLBACK_MODELS= disables the fallback chain — that is a
# decision, not an omission; leaving the variable unset falls through to
# GEMINI_FALLBACK_MODELS and then to the built-in defaults.
# FRIDAY_MODEL=ollama/llama3.2
# FRIDAY_FALLBACK_MODELS=
# MAX_AGENT_ITERATIONS=15
# MAX_CONTEXT_TOKENS=900000    ← now actually enforced: oldest turns are shed
# STREAMING=True

# --- Tool filtering -------------------------------------------------------
# Only tools relevant to the current request are sent to the model. The full
# 108-tool declaration set costs ~8.6k tokens on EVERY call — more than
# free-tier fallback providers allow per minute (Groq on-demand: 8k TPM),
# which used to 413-kill every fallback model.
# TOOL_FILTER=True
# MAX_TOOLS_PER_CALL=40     ← set to 0 to always send every tool
